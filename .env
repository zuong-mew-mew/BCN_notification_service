# 1. CỔNG MÁY CHỦ
PORT=8080

# 2. CẤU HÌNH KÊNH ZALO
#trạng thái chức năng
ZALO_ENABLED=true
ZALO_BOT_API_URL=http://localhost:____/api/send-group-message
# ID group ZALO BCN notification
BCN_ZALO_GROUP_ID=
# Danh sách UID Zalo của các Mentor (để sau này gửi tin duyệt bài riêng)
MENTOR_ZALO_UIDS= ____ , ______ , _____


# 3. CẤU HÌNH KÊNH DISCORD
#trạng thái chức năng
DISCORD_ENABLED=true
# webhoook kênh  discord Notification của BCN
DISCORD_WEBHOOKS_BCN=
#webhoook kênh discord ADMIN riêng tư  để nhận QR khi bot zalo hết hạn cookie
DISCORD_ADMIN_GET_QR_PRIVATE_WEBHOOK=



# 4. KÊNH GIẢ LẬP IN RA MÀN HÌNH TERMINAL (ĐỂ TEST NHANH KHI CHƯA CÓ BOT THẬT)
MOCK_ENABLED=true
